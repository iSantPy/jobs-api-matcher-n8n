    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst parsedItems = items.map(item => {\n\n  const raw = item.json.content.parts[0].text;\n\n  const cleaned = raw\n    .replace(/```json/g, '')\n    .replace(/```/g, '')\n    .trim();\n\n  return {\n    json: JSON.parse(cleaned)\n  };\n});\n\nreturn parsedItems;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1824,
        -16
      ],
      "id": "8d0627fd-9926-48f9-bc2c-caccaa7739c5",
      "name": "Parsing data"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nlet message = `🚀 Jobs encontrados\\n\\n`;\n\nfor (const item of items) {\n\n  const job = item.json;\n\n  message +=\n`🏢 ${job.company}\n💼 ${job.title}\n⭐ Score: ${job.total_score}\n📊 Match: ${job.match_level}\n\n✅ Strengths:\n${job.strengths.map(s => `- ${s}`).join('\\n')}\n\n⚠️ Gaps:\n${job.gaps.map(g => `- ${g}`).join('\\n')}\n\n🎯 Recommendation: ${job.recommendation}\n\n----------------------------\n\n`;\n}\n\nreturn [\n  {\n    json: {\n      message\n    }\n  }\n];"
      },
